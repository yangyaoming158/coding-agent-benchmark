# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会提交。
# 所有密钥只放在这里，不要写进 .bashrc 或代码。

# ── 数据库 ──
# 端口是 5433 不是 5432：开发机上还有别的项目在用 Postgres，抢端口会让两边都起不来。
# 本地容器用 `make db-up` 起。
BENCH_DATABASE_URL=postgresql+psycopg://bench:bench@localhost:5433/bench

# ── 制品存储：local 用本地文件系统，minio 用对象存储 ──
# 换后端只改 ARTIFACT_BACKEND 这一项，业务代码不用动（ADR-005）。
# MinIO 是 E10-T2 的活，现在只能填 local。
# ARTIFACT_LOCAL_ROOT 写相对路径时，基准是**仓库根目录**，不是当前工作目录 ——
# 不然 `cd backend` 起的 API 和在仓库根起的 Worker 会写到两个不同的目录里。
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=./var/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bench-artifacts

# ── 沙箱工作区（相对路径同样以仓库根目录为基准）──
# MIRROR_ROOT     每个仓库一份 git bare mirror，物化工作区时从它 git archive，不联网 clone
# WORKSPACE_ROOT  每次评测物化出来的代码工作区
# GIT_TIMEOUT_S   单条 git 命令的超时；最坏情况是第一次 clone 大仓库且要过代理
MIRROR_ROOT=./var/mirrors
WORKSPACE_ROOT=./var/workspaces
GIT_TIMEOUT_S=1800

# ── 并发（含义见 docs/plan/01-requirements.md §4.6）──
# AGENT_CONCURRENCY  同时有几个被测 AI 在干活，受服务商限流约束
# SANDBOX_CONCURRENCY 同时跑几个测试容器，受 CPU 和内存约束
AGENT_CONCURRENCY=10
SANDBOX_CONCURRENCY=5

# ── 被测 AI 的密钥（按需填，不用的留空）──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ── 失败归因用的模型（用便宜的快模型即可）──
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# ── GitHub 任务挖掘 ──
GITHUB_TOKEN=

# ── 沙箱出网代理（Agent 容器访问大模型 API 用；测试容器始终断网）──
# 地址是 WSL 网关，wsl --shutdown 后可能变化，用 `ip route show default` 取
SANDBOX_HTTP_PROXY=

# ── 管理接口令牌 ──
ADMIN_TOKEN=

# ── 日志 ──
# LOG_FORMAT: console 带颜色，适合盯着终端看；json 适合 grep 和 jq。
# 日志里的密钥会被自动替换成 ***REDACTED***，细节见 app/infrastructure/logging.py。
LOG_LEVEL=INFO
LOG_FORMAT=console
