# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会提交。
# 所有密钥只放在这里，不要写进 .bashrc 或代码。

# ── 数据库 ──
# 端口是 5433 不是 5432：开发机上还有别的项目在用 Postgres，抢端口会让两边都起不来。
# 本地容器用 `make db-up` 起。
BENCH_DATABASE_URL=postgresql+psycopg://bench:bench@localhost:5433/bench

# ── 制品存储：local 用本地文件系统，minio 用对象存储 ──
# 换后端只改 ARTIFACT_BACKEND 这一项，业务代码不用动（ADR-005）。
# MinIO 是 E10-T2 的活，现在只能填 local。
# ARTIFACT_LOCAL_ROOT 写相对路径时，基准是**仓库根目录**，不是当前工作目录 ——
# 不然 `cd backend` 起的 API 和在仓库根起的 Worker 会写到两个不同的目录里。
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=./var/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bench-artifacts

# ── 沙箱工作区（相对路径同样以仓库根目录为基准）──
# MIRROR_ROOT     每个仓库一份 git bare mirror，物化工作区时从它 git archive，不联网 clone
# WORKSPACE_ROOT  每次评测物化出来的代码工作区
# GIT_TIMEOUT_S   单条 git 命令的超时；最坏情况是第一次 clone 大仓库且要过代理
MIRROR_ROOT=./var/mirrors
WORKSPACE_ROOT=./var/workspaces
GIT_TIMEOUT_S=1800

# ── 镜像构建（E2-T3）──
# BUILD_SNAPSHOT_ROOT        建 env 镜像用的浅克隆。刻意和 MIRROR_ROOT 分开：
#                            浅克隆只有一个 commit，混进 mirrors 会让别处误以为历史是全的
# IMAGE_DISK_MIN_FREE_RATIO  镜像分区剩余低于这个比例就拒绝开建
BUILD_SNAPSHOT_ROOT=./var/build-snapshots
IMAGE_DISK_MIN_FREE_RATIO=0.15

# ── 并发（含义见 docs/plan/01-requirements.md §4.6）──
# WORKER_SLOTS        一个 Worker 同时在途几道题。这就是对外声明的"并行度"
# AGENT_CONCURRENCY   同时有几个被测 AI 在干活，受服务商限流约束
# SANDBOX_CONCURRENCY 同时跑几个测试容器，受 CPU 和内存约束
#
# 三个数管的不是同一件事：槽位管"手里有几道题"，另外两个管"这一刻允许几个在
# 调 AI、几个在跑测试"。槽位设得比后两者之和大没有意义——多出来的作业只会占着
# 租约卡在信号量上，既不干活又让在途任务数虚高。
WORKER_SLOTS=8
AGENT_CONCURRENCY=10
SANDBOX_CONCURRENCY=4

# ── 内存（E9-T2）──
# AGENT_MEMORY_MB / AGENT_CPUS      Agent 容器的限额。E9-T2 之前没人显式设过，
#                                   捡的是按测试容器定的 1536 MB
# SANDBOX_MIN_AVAILABLE_MB          宿主可用内存低于这个数就先别开新的测试容器。
#                                   0 = 关掉刹车
# SANDBOX_MEMORY_WAIT_TIMEOUT_S     刹车最多等多久，等过了放行并告警（不死等）
AGENT_MEMORY_MB=1024
AGENT_CPUS=1.0
SANDBOX_MIN_AVAILABLE_MB=2048
SANDBOX_MEMORY_WAIT_TIMEOUT_S=120

# ── 被测 AI 的密钥（按需填，不用的留空）──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ── 平台自己要调的模型：E1-T5 候选预筛、E6-T2 失败归因（用便宜的快模型即可）──
# 写法是 `厂商/模型`，比如 deepseek/deepseek-chat、gpt-4o、qwen-plus。
# Key 按模型名自动从上面那几个里挑；JUDGE_API_KEY 只在走中转站时才要填。
JUDGE_MODEL=deepseek/deepseek-chat
JUDGE_API_KEY=
JUDGE_BASE_URL=

# 调模型时走不走代理。**留空 = 直连，而且不会去读 shell 里的 HTTP_PROXY。**
# 国产模型（DeepSeek、通义）直连就好，绕境外代理只会更慢更不稳；
# 而这台机器的 ALL_PROXY 是 socks5h://，httpx 认它要额外装 socksio。
# 要打境外模型（OpenAI、Anthropic）时才填。
LLM_HTTP_PROXY=

# ── GitHub 任务挖掘 ──
GITHUB_TOKEN=

# ── 沙箱出网代理（Agent 容器访问大模型 API 用；测试容器始终断网）──
# 地址是 WSL 网关，wsl --shutdown 后可能变化，用 `ip route show default` 取
SANDBOX_HTTP_PROXY=

# ── 管理接口令牌 ──
ADMIN_TOKEN=

# ── 日志 ──
# LOG_FORMAT: console 带颜色，适合盯着终端看；json 适合 grep 和 jq。
# 日志里的密钥会被自动替换成 ***REDACTED***，细节见 app/infrastructure/logging.py。
LOG_LEVEL=INFO
LOG_FORMAT=console
