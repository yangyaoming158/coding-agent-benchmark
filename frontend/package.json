{
  "name": "coding-agent-benchmark-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/api-types.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check:display": "node scripts/check-display.mjs",
    "check:task-detail": "node scripts/check-task-detail.mjs",
    "check:leaderboard": "node scripts/check-leaderboard.mjs",
    "check:tasks": "node scripts/check-tasks.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "check:analysis": "node scripts/check-analysis.mjs",
    "check": "npm run -s check:display && npm run -s check:task-detail && npm run -s check:leaderboard && npm run -s check:tasks && npm run -s check:dashboard && npm run -s check:analysis"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
